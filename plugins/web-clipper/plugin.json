{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "web-clipper",
  "version": "1.0.0",
  "description": "提取公开网页正文并保存为带来源的本地 Markdown 剪藏，可检索已收集资料。",
  "author": {
    "name": "XOPC",
    "url": "https://xopc.ai"
  },
  "repository": "https://github.com/xopcai/xopc-plugins",
  "license": "Apache-2.0",
  "keywords": [
    "web-clipper",
    "office",
    "research",
    "中文",
    "productivity"
  ],
  "extensions": {
    "ai.xopc": {
      "branding": {
        "icon": "assets/icon.svg"
      },
      "localizations": {
        "zh-CN": {
          "displayName": "网页剪藏",
          "description": "提取公开网页正文并保存为带来源的本地 Markdown 剪藏，可检索已收集资料。"
        },
        "en": {
          "displayName": "Web Clipper",
          "description": "提取公开网页正文并保存为带来源的本地 Markdown 剪藏，可检索已收集资料。"
        }
      }
    }
  }
}
