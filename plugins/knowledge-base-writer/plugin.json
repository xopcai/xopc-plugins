{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "knowledge-base-writer",
  "version": "1.1.1",
  "description": "Turn resolved support knowledge into a searchable, safe, and maintainable help article.",
  "author": {
    "name": "XOPC",
    "url": "https://xopc.ai"
  },
  "homepage": "https://github.com/xopcai/xopc-plugins/tree/main/plugins/knowledge-base-writer",
  "repository": "https://github.com/xopcai/xopc-plugins",
  "license": "Apache-2.0",
  "keywords": [
    "customer-support",
    "knowledge",
    "base",
    "writer"
  ],
  "extensions": {
    "ai.xopc": {
      "branding": {
        "icon": "assets/icon.svg"
      },
      "localizations": {
        "en": {
          "displayName": "Knowledge Base Writer",
          "description": "Turn resolved support knowledge into a searchable, safe, and maintainable help article."
        },
        "zh-CN": {
          "displayName": "知识库撰写",
