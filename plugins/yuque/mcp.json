{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "yuque": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/provider.mjs",
        "yuque",
        "serve"
      ],
      "env": {
        "XOPC_ACCOUNT_HOME": "${PLUGIN_ACCOUNTS}/yuque",
        "ACCESS_TOKEN": "${user_config.accessToken}"
      }
    }
  }
}
