{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "localization-review",
  "version": "1.1.1",
  "description": "Review localized content for meaning, terminology, cultural fit, formatting, and functional constraints.",
  "author": {
    "name": "XOPC",
    "url": "https://xopc.ai"
  },
  "homepage": "https://github.com/xopcai/xopc-plugins/tree/main/plugins/localization-review",
  "repository": "https://github.com/xopcai/xopc-plugins",
  "license": "Apache-2.0",
  "keywords": [
    "content-creation",
    "localization",
    "review"
  ],
  "extensions": {
    "ai.xopc": {
      "branding": {
        "icon": "assets/icon.svg"
      },
      "localizations": {
        "en": {
          "displayName": "Localization Review",
          "description": "Review localized content for meaning, terminology, cultural fit, formatting, and functional constraints."
        },
        "zh-CN": {
          "displayName": "本地化评审",
          "description": "评审本地化内容的语义、术语、文化适配、格式与功能约束。"
        }
      }
    }
  }
}
